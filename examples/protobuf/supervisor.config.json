{
  "version": 1,
  "schemas": [
    {
      "path": "robot.proto"
    }
  ],
  "devices": [
    {
      "id": "router",
      "name": "Router",
      "url": "ws://127.0.0.1:10000",
      "group": "Example",
      "autoConnect": true,
      "readOnly": true,
      "subscriptions": [
        {
          "id": "state",
          "keyexpr": "demo/*/state",
          "label": "Robot state",
          "kind": "data",
          "staleAfterSec": 5,
          "decoder": {
            "kind": "protobuf",
            "messageType": "demo.Envelope"
          },
          "latency": {
            "source": "json",
            "field": "timestamp",
            "unit": "ns"
          }
        },
        {
          "id": "command",
          "keyexpr": "demo/*/command",
          "label": "Robot command",
          "kind": "data",
          "staleAfterSec": 5,
          "decoder": {
            "kind": "protobuf",
            "messageType": "demo.Envelope"
          },
          "latency": {
            "source": "json",
            "field": "timestamp",
            "unit": "ns"
          }
        }
      ]
    }
  ]
}
