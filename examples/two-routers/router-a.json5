{
  // Router A: devices on tcp/7447, supervisor on ws://127.0.0.1:10000.
  mode: "router",
  listen: { endpoints: ["tcp/127.0.0.1:7447"] },
  scouting: { multicast: { enabled: false } },
  timestamping: { enabled: true },
  plugins_loading: { enabled: true, search_dirs: ["/usr/lib"] },
  plugins: { remote_api: { websocket_port: "10000" } },
}
