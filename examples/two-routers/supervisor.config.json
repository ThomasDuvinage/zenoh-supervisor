{
  "version": 1,
  "devices": [
    {
      "id": "router-a",
      "name": "Router A",
      "url": "ws://127.0.0.1:10000",
      "group": "Example",
      "autoConnect": true,
      "readOnly": true,
      "subscriptions": [
        { "id": "temp", "keyexpr": "demo/*/temperature", "label": "Temperature", "kind": "data", "unit": "°C", "min": 0, "max": 80, "staleAfterSec": 5, "latency": { "source": "zenoh" } },
        { "id": "alive", "keyexpr": "devices/*/alive", "label": "Devices online", "kind": "liveliness" }
      ]
    },
    {
      "id": "router-b",
      "name": "Router B",
      "url": "ws://127.0.0.1:10001",
      "group": "Example",
      "autoConnect": true,
      "readOnly": true,
      "subscriptions": [
        { "id": "temp", "keyexpr": "demo/*/temperature", "label": "Temperature", "kind": "data", "unit": "°C", "min": 0, "max": 80, "staleAfterSec": 5, "latency": { "source": "zenoh" } },
        { "id": "alive", "keyexpr": "devices/*/alive", "label": "Devices online", "kind": "liveliness" }
      ]
    }
  ]
}
